# Copy this file to .env and adjust values for your machine.

DEBUG=True
SECRET_KEY=change-this-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# --- AI performance tuning (Intel i5 / 8GB RAM target) ---
# Options: 4, 6, 8
AI_PROCESSING_FPS=6

# YOLO confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.45

# Camera capture resolution used by the browser (informational; enforced in JS)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Path to a custom-trained YOLO model. If the file does not exist,
# the app automatically falls back to the lightweight pretrained model.
CUSTOM_MODEL_PATH=models/custom/best.pt

# Pretrained lightweight YOLO model (auto-downloaded by ultralytics on first run)
PRETRAINED_MODEL_NAME=yolov8n.pt

# Left/Right zone thresholds (fraction of frame width, 0-1)
LEFT_THRESHOLD=0.35
RIGHT_THRESHOLD=0.65

# Minimum seconds between spoken navigation updates
VOICE_COOLDOWN=1.5

# Performance mode: low | balanced | high
PERFORMANCE_MODE=balanced
